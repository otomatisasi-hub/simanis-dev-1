app.post(
  '/api/invoice/complete',
  validateRole('keuangan'),
  upload.single('file'),
  async (req, res) => {
    try {
      const { financeId, serviceId, invoiceNumber, amount, dueDate, notes } =
        req.body

      if (!financeId || !serviceId || !invoiceNumber || !req.file || !dueDate) {
        return res.status(400).json({ success: false, error: 'Missing fields' })
      }

      const userId = req.userId
      const fileUrl = `/uploads/documents/${req.file.filename}`

      const { data: payment, error: paymentError } = await supabase
        .from('service_fee_payments')
        .insert({
          service_finance_id: financeId,
          service_id: serviceId,
          payment_type: 'invoice',
          amount: amount ? Number(amount) : null,
          paid_at: dueDate,
          file_url: fileUrl,
          file_name: req.file.originalname,
          file_mime_type: req.file.mimetype,
          confirmation_status: 'confirmed',
          notes: notes || null,
          created_by: userId,
        })
        .select()
        .single()

      if (paymentError) throw paymentError

      const { error: financeError } = await supabase
        .from('service_finances')
        .update({
          status: 'completed',
          invoice_number: invoiceNumber,
          amount: amount ? Number(amount) : null,
          due_date: dueDate,
          updated_at: new Date().toISOString(),
          updated_by: userId,
        })
        .eq('id', financeId)

      if (financeError) throw financeError

      res.json({ success: true, data: payment, fileUrl })
    } catch (err) {
      console.error('/api/invoice/complete error:', err)
      res.status(500).json({ success: false, error: err.message })
    }
  },
)

// ============================================
// ADMIN - USER MANAGEMENT
// ============================================
app.get(
  '/api/admin/users',
  validateRole(['admin', 'super_admin']),
  async (req, res) => {
    try {
      console.log('📥 Fetching all users...')
      const { data: authData, error: authError } =
        await supabase.auth.admin.listUsers()

      if (authError) throw authError

      const enrichedUsers = await Promise.all(
        authData.users.map(async (user) => {
          const { data: profile } = await supabase
            .from('profiles')
            .select('full_name, phone, employee_id')
            .eq('user_id', user.id)
            .maybeSingle()

          const { data: roleData } = await supabase
            .from('user_roles')
            .select('role, assigned_at')
            .eq('user_id', user.id)
            .maybeSingle()

          return {
            id: user.id,
            nama:
              profile?.full_name ||
              user.email?.split('@')[0] ||
              'Unknown',
            email: user.email,
            employee_id: profile?.employee_id || null,
            phone: profile?.phone || null,
            isactive: !user.banned_until,
            createdat: user.created_at,
            role: roleData?.role || null,
            user_roles: roleData
              ? [{ role: roleData.role, assigned_at: roleData.assigned_at }]
              : [],
          }
        }),
      )

      console.log(`✅ Fetched ${enrichedUsers.length} users`)
      res.json({
        success: true,
        data: enrichedUsers,
        total: enrichedUsers.length,
      })
    } catch (error) {
      console.error('💥 Get users error:', error)
      res.status(500).json({ success: false, error: error.message })
    }
  },
)

app.get(
  '/api/admin/users/:userId/permissions',
  validateRole(['admin', 'super_admin']),
  async (req, res) => {
    try {
      console.log(`📥 Fetching permissions for user: ${req.params.userId}`)

      const { data: permissions, error } = await supabase
        .from('userpermissions')
        .select('*')
        .eq('user_id', req.params.userId)
        .order('resource')

      if (error) throw error

      if (!permissions || permissions.length === 0) {
        const defaultResources = [
          'dashboard',
          'layanan_ppat',
          'layanan_keuangan_ppat',
          'layanan_notaril',
          'layanan_keuangan_notaril',
          'layanan_syariah',
          'layanan_keuangan_syariah',
          'administrator',
        ]

        const defaults = defaultResources.map((resource) => ({
          user_id: req.params.userId,
          resource,
          can_create: false,
          can_read: resource === 'dashboard',
          can_update: false,
          can_delete: false,
        }))

        const { data: created, error: insertError } = await supabase
          .from('userpermissions')
          .insert(defaults)
          .select()

        if (insertError) throw insertError
        return res.json({ success: true, data: created })
      }

      res.json({ success: true, data: permissions })
    } catch (error) {
      console.error('💥 Get permissions error:', error)
      res.status(500).json({ success: false, error: error.message })
    }
  },
)

app.put(
  '/api/admin/users/:userId/permissions',
  validateRole(['admin', 'super_admin']),
  async (req, res) => {
    try {
      const { permissions } = req.body
      if (!Array.isArray(permissions)) {
        return res.status(400).json({
          success: false,
          error: 'Permissions must be array',
        })
      }

      await supabase
        .from('userpermissions')
        .delete()
        .eq('user_id', req.params.userId)

      const inserts = permissions.map((p) => ({
        user_id: req.params.userId,
        resource: p.resource,
        can_create: p.can_create || false,
        can_read: p.can_read || false,
        can_update: p.can_update || false,
        can_delete: p.can_delete || false,
      ))

      const { data, error } = await supabase
        .from('userpermissions')
        .insert(inserts)
        .select()
      if (error) throw error

      console.log(`✅ Updated ${data.length} permissions for ${req.params.userId}`)
      res.json({ success: true, message: 'Permissions updated', data })
    } catch (error) {
      console.error('💥 Update permissions error:', error)
      res.status(500).json({ success: false, error: error.message })
    }
  },
)

app.put(
  '/api/admin/users/:userId/role',
  validateRole(['super_admin']),
  async (req, res) => {
    try {
      const { role } = req.body
      const validRoles = [
        'super_admin',
        'admin',
        'notaris',
        'ppat',
        'syariah',
        'keuangan',
      ]

      if (!validRoles.includes(role)) {
        return res
          .status(400)
          .json({ success: false, error: 'Invalid role' })
      }

      const { data: existing } = await supabase
        .from('user_roles')
        .select('*')
        .eq('user_id', req.params.userId)
        .maybeSingle()

      let result
      if (existing) {
        const { data, error } = await supabase
          .from('user_roles')
          .update({
            role,
            assigned_at: new Date().toISOString(),
            assigned_by: req.userId,
          })
          .eq('user_id', req.params.userId)
          .select()
          .single()

        if (error) throw error
        result = data
      } else {
        const { data, error } = await supabase
          .from('user_roles')
          .insert({
            user_id: req.params.userId,
            role,
            assigned_by: req.userId,
          })
          .select()
          .single()

        if (error) throw error
        result = data
      }

      console.log(`✅ Role updated: ${req.params.userId} → ${role}`)
      res.json({ success: true, message: 'Role updated', data: result })
    } catch (error) {
      console.error('💥 Update role error:', error)
      res.status(500).json({ success: false, error: error.message })
    }
  },
)

app.post(
  '/api/admin/users/:userId/transfer-and-delete',
  validateRole('super_admin'),
  async (req, res) => {
    const sourceUserId = req.params.userId
    const { targetUserId } = req.body

    try {
      if (!targetUserId) {
        return res.status(400).json({
          success: false,
          error: 'targetUserId is required',
        })
      }
      if (sourceUserId === targetUserId) {
        return res.status(400).json({
          success: false,
          error: 'Source and target user must be different',
        })
      }

      const { data: authData, error: authError } =
        await supabase.auth.admin.listUsers()
      if (authError) throw authError

      const users = authData.users || []
      const sourceExists = users.some((u) => u.id === sourceUserId)
      const targetExists = users.some((u) => u.id === targetUserId)

      if (!sourceExists) {
        return res.status(404).json({
          success: false,
          error: 'Source user not found',
        })
      }
      if (!targetExists) {
        return res.status(404).json({
          success: false,
          error: 'Target user not found',
        })
      }

      const { error: rpcError } = await supabase.rpc(
        'transfer_and_delete_user',
        {
          old_user: sourceUserId,
          new_user: targetUserId,
        },
      )
      if (rpcError) throw rpcError

      return res.json({
        success: true,
        message:
          'User data transferred and user deleted/disabled successfully',
      })
    } catch (error) {
      console.error('Transfer and delete user error', error)
      return res.status(500).json({
        success: false,
        error: error.message || 'Internal server error',
      })
    }
  },
)

app.get(
  '/api/admin/users/:userId/transfer-preview',
  validateRole('admin', 'super_admin'),
  async (req, res) => {
    const sourceUserId = req.params.userId
    const targetUserId = req.query.targetUserId

    try {
      if (!targetUserId) {
        return res.status(400).json({
          success: false,
          error: 'targetUserId is required',
        })
      }
      if (sourceUserId === targetUserId) {
        return res.status(400).json({
          success: false,
          error: 'Source and target user must be different',
        })
      }

      const { count: clientsTotal, error: clientsError } = await supabase
        .from('clients')
        .select('id', { count: 'exact', head: true })
        .eq('created_by', sourceUserId)

      if (clientsError) throw clientsError

      const { count: servicesTotal, error: servicesError } = await supabase
        .from('services')
        .select('id', { count: 'exact', head: true })
        .or(`created_by.eq.${sourceUserId},assigned_to.eq.${sourceUserId}`)

      if (servicesError) throw servicesError

      return res.json({
        success: true,
        data: {
          clients_created_by: clientsTotal ?? 0,
          services_related: servicesTotal ?? 0,
        },
      })
    } catch (error) {
      console.error('Transfer preview error', error)
      return res.status(500).json({
        success: false,
        error: error.message || 'Internal server error',
      })
    }
  },
)

