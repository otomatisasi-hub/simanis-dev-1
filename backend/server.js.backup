// ============================================
// ES MODULE VERSION - server.js (CLEAN & FIXED)
// ============================================
import dotenv from 'dotenv'
import { fileURLToPath } from 'url'
import path from 'path'
import express from 'express'
import multer from 'multer'
import cors from 'cors'
import fs from 'fs'
import { createClient } from '@supabase/supabase-js'

const __filename = fileURLToPath(import.meta.url)
const __dirname = path.dirname(__filename)

dotenv.config({ path: path.resolve(__dirname, '../.env') })

const app = express()
const PORT = process.env.PORT || 3001

app.use(function (req, res, next) {
  res.header(
    'Access-Control-Allow-Origin',
    'https://22877e8b6fa1.ngrok-free.app',
  )
  res.header(
    'Access-Control-Allow-Headers',
    'Origin, X-Requested-With, Content-Type, Accept, Authorization',
  )
  res.header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS')
  next()
})

// ============================================
// ENVIRONMENT VALIDATION
// ============================================
let supabaseUrl = process.env.VITE_SUPABASE_URL
const supabaseKey = process.env.SUPABASE_SERVICE_ROLE_KEY

if (supabaseUrl && supabaseUrl.endsWith('/')) {
  supabaseUrl = supabaseUrl.slice(0, -1)
}

console.log('✅ Checking environment variables...')
console.log('Supabase URL:', supabaseUrl ? 'Found' : '❌ Missing')
console.log('Supabase Key:', supabaseKey ? 'Found (SERVICE_ROLE)' : '❌ Missing')

if (!supabaseUrl || !supabaseKey) {
  console.error('❌ ERROR: Missing Supabase credentials')
  process.exit(1)
}

// ============================================
// SUPABASE CLIENT
// ============================================
let supabase
try {
  supabase = createClient(supabaseUrl, supabaseKey, {
    auth: {
      autoRefreshToken: false,
      persistSession: false,
      detectSessionInUrl: false,
    },
  })
  console.log('✅ Supabase client initialized (SERVICE_ROLE)')
} catch (error) {
  console.error('❌ Failed to initialize Supabase:', error.message)
  process.exit(1)
}

// ============================================
// MIDDLEWARE
// ============================================
app.use(cors())
app.use(express.json())
app.use('/uploads', express.static(path.join(__dirname, '../public/uploads')))

// ============================================
// UPLOAD SETUP
// ============================================
const uploadDir = path.join(__dirname, '../public/uploads/documents')
if (!fs.existsSync(uploadDir)) {
  fs.mkdirSync(uploadDir, { recursive: true })
  console.log('📁 Created upload directory:', uploadDir)
}

const storage = multer.diskStorage({
  destination: (req, file, cb) => cb(null, uploadDir),
  filename: (req, file, cb) => {
    const { stepId, docId, requestId } = req.body
    const ext = path.extname(file.originalname)
    const prefix = requestId || stepId || docId || 'doc'
    cb(null, `${prefix}-${Date.now()}${ext}`)
  },
})

// Terima semua jenis file (batas ukuran tetap 10MB)
const fileFilter = (req, file, cb) => {
  cb(null, true)
}

const upload = multer({
  storage,
  fileFilter,
  limits: { fileSize: 10 * 1024 * 1024 },
})

// ============================================
// MIDDLEWARE - ROLE VALIDATION
// ============================================
// Versi baru: bisa dipakai sebagai validateRole('admin'),
// validateRole('admin','super_admin') atau validateRole(['admin','super_admin'])
function validateRole(...allowedRolesInput) {
  const flatAllowedRoles = allowedRolesInput.flat()

  return async (req, res, next) => {
    try {
      const authHeader = req.headers.authorization
      if (!authHeader) {
        return res
          .status(401)
          .json({ success: false, error: 'No token provided' })
      }

      const token = authHeader.replace('Bearer ', '').trim()

      // ✅ Add timeout untuk prevent ETIMEDOUT
      const timeoutPromise = new Promise((_, reject) =>
        setTimeout(() => reject(new Error('Auth timeout')), 8000),
      )

      const authPromise = supabase.auth.getUser(token)

      const {
        data: { user },
        error: authError,
      } = await Promise.race([authPromise, timeoutPromise])

      if (authError || !user) {
        console.error('❌ Auth error:', authError?.message || 'Unknown')
        return res
          .status(401)
          .json({ success: false, error: 'Invalid or expired token' })
      }

      console.log('✅ User authenticated:', user.email)

      const { data: userRole, error: roleError } = await supabase
        .from('user_roles')
        .select('role')
        .eq('user_id', user.id)
        .maybeSingle()

      if (roleError || !userRole) {
        console.error('❌ Role fetch error:', roleError?.message)
        return res
          .status(403)
          .json({ success: false, error: 'No role assigned' })
      }

      const normalizeRole = (role) => role.toLowerCase().replace(/_/g, '')
      const normalizedUserRole = normalizeRole(userRole.role)
      const normalizedAllowedRoles = flatAllowedRoles.map((r) => normalizeRole(r))
      const hasPermission = normalizedAllowedRoles.includes(normalizedUserRole)

      if (!hasPermission) {
        return res
          .status(403)
          .json({ success: false, error: 'Access denied' })
      }

      req.user = user
      req.userRole = userRole.role
      req.userId = user.id

      console.log('✅ Access granted to:', user.email)
      next()
    } catch (error) {
      console.error('💥 Validation error:', error)
      if (error.message === 'Auth timeout') {
        return res.status(503).json({
          success: false,
          error: 'Authentication timeout. Please try again.',
        })
      }

      return res
        .status(500)
        .json({ success: false, error: 'Internal server error' })
    }
  }
}

// ============================================
// HEALTH CHECK
// ============================================
app.get('/api/health', (req, res) => {
  res.json({
    success: true,
    message: 'Server running',
    timestamp: new Date().toISOString(),
  })
})

// ============================================
// UPLOAD ENDPOINTS
// ============================================
app.post('/api/upload', upload.single('file'), (req, res) => {
  try {
    if (!req.file)
      return res
        .status(400)
        .json({ success: false, error: 'No file provided' })
    const fileUrl = `/uploads/documents/${req.file.filename}`
    res.json({
      success: true,
      fileUrl,
      fileName: req.file.originalname,
      fileSize: req.file.size,
    })
  } catch (error) {
    res.status(500).json({ success: false, error: error.message })
  }
})

app.delete('/api/delete', (req, res) => {
  try {
    const { fileUrl } = req.body
    if (!fileUrl)
      return res
        .status(400)
        .json({ success: false, error: 'File URL required' })

    const filePath = path.join(uploadDir, path.basename(fileUrl))
    if (fs.existsSync(filePath)) fs.unlinkSync(filePath)

    res.json({ success: true, message: 'File deleted' })
  } catch (error) {
    res.status(500).json({ success: false, error: error.message })
  }
})

// ============================================
// PNBP ENDPOINTS
// ============================================
app.post('/api/pnbp/request', async (req, res) => {
  try {
    const serviceId = req.body.service_id || req.body.serviceId
    const workflowStepInstanceId =
      req.body.workflow_step_instance_id || req.body.workflowStepInstanceId
    const requestedBy = req.body.requested_by || req.body.requestedBy

    if (!serviceId || !workflowStepInstanceId || !requestedBy) {
      return res
        .status(400)
        .json({ success: false, error: 'Missing required fields' })
    }

    const { data: existing } = await supabase
      .from('pnbp_requests')
      .select('*')
      .eq('workflow_step_instance_id', workflowStepInstanceId)
      .maybeSingle()

    if (existing)
      return res.json({
        success: true,
        message: 'Request exists',
        data: existing,
      })

    const { data, error } = await supabase
      .from('pnbp_requests')
      .insert({
        service_id: serviceId,
        workflow_step_instance_id: workflowStepInstanceId,
        requested_by: requestedBy,
        status: 'pending',
      })
      .select()
      .single()

    if (error) throw error
    res.json({ success: true, message: 'Request created', data })
  } catch (error) {
    res.status(500).json({ success: false, error: error.message })
  }
})

app.get('/api/pnbp/request/:id', async (req, res) => {
  try {
    const { data, error } = await supabase
      .from('pnbp_requests')
      .select(
        `
    id,
    service_id,
    workflow_step_instance_id,
    requested_by,
    completed_by,
    requested_at,
    completed_at,
    status,
    hold_reason,
    notes,
    services (
      id,
      title,
      deadline,
      client_id,
      clients (
        id,
        full_name
      )
    ),
    workflow_step_instances (
      id,
      step_order,
      workflow_instances (
        id,
        workflow_templates (
          id,
          workflow_template_steps (
            id,
            step_order,
            step_name
          )
        )
      )
    )
  `,
      )
      .eq('id', req.params.id)
      .maybeSingle()

    if (error) throw error
    if (!data) {
      return res.status(404).json({ success: false, error: 'Not found' })
    }

    let requestedByProfile = null
    if (data.requested_by) {
      const { data: profile, error: profileError } = await supabase
        .from('profiles')
        .select('user_id, full_name')
        .eq('user_id', data.requested_by)
        .maybeSingle()

      if (profileError) throw profileError
      requestedByProfile = profile
        ? { id: profile.user_id, full_name: profile.full_name }
        : null
    }

    const enriched = {
      ...data,
      requested_by_profile: requestedByProfile,
    }

    res.json({ success: true, data: enriched })
  } catch (error) {
    console.error('💥 /api/pnbp/request/:id error:', error)
    res.status(500).json({ success: false, error: error.message })
  }
})

app.get('/api/pnbp/status/:workflowStepInstanceId', async (req, res) => {
  try {
    const { data, error } = await supabase
      .from('pnbp_requests')
      .select('*')
      .eq('workflow_step_instance_id', req.params.workflowStepInstanceId)
      .maybeSingle()

    if (error) throw error
    res.json({ success: true, data: data || null })
  } catch (error) {
    res.status(500).json({ success: false, error: error.message })
  }
})

// ============================================
// INVOICE REQUESTS LIST (untuk Keuangan)
// ============================================
app.get(
  '/api/invoice/requests',
  validateRole('keuangan', 'admin', 'super_admin'),
  async (req, res) => {
    try {
      const { status } = req.query

      let query = supabase
        .from('service_finances')
        .select(
          `
          id,
          service_id,
          follow_up_type,
          status,
          due_date,
          amount,
          invoice_number,
          services (
            id,
            title,
            clients (
              id,
              full_name
            )
          )
        `,
        )
        .eq('follow_up_type', 'Pembuatan Invoice')
        .order('created_at', { ascending: false })

      if (status) {
        query = query.eq('status', status)
      }

      const { data, error } = await query
      if (error) throw error

      res.json({
        success: true,
        data: data || [],
      })
    } catch (error) {
      console.error('💥 /api/invoice/requests error:', error)
      res.status(500).json({
        success: false,
        error: error.message,
      })
    }
  },
)

// PNBP complete & hold
app.post('/api/pnbp/complete', async (req, res) => {
  try {
    const { requestId, completedBy, notes } = req.body
    if (!requestId || !completedBy) {
      return res.status(400).json({ success: false, error: 'Missing fields' })
    }

    const { data, error } = await supabase
      .from('pnbp_requests')
      .update({
        status: 'completed',
        completed_by: completedBy,
        completed_at: new Date().toISOString(),
        notes,
      })
      .eq('id', requestId)
      .select()
      .single()

    if (error) throw error
    res.json({ success: true, data })
  } catch (error) {
    res.status(500).json({ success: false, error: error.message })
  }
})

app.post('/api/pnbp/hold', async (req, res) => {
  try {
    const { requestId, completedBy, holdReason } = req.body
    if (!requestId || !holdReason) {
      return res.status(400).json({ success: false, error: 'Missing fields' })
    }

    const { data, error } = await supabase
      .from('pnbp_requests')
      .update({
        status: 'hold',
        completed_by: completedBy,
        hold_reason: holdReason,
      })
      .eq('id', requestId)
      .select()
      .single()

    if (error) throw error
    res.json({ success: true, data })
  } catch (error) {
    res.status(500).json({ success: false, error: error.message })
