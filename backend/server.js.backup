})

// ✅ Upload dokumen PNBP oleh role keuangan
app.post(
  '/api/pnbp/upload-document',
  validateRole('keuangan', 'admin', 'super_admin'),
  upload.single('file'),
  async (req, res) => {
    try {
      const { requestId, serviceId, serviceFinanceId, amount, paidAt, notes } =
        req.body

      if (!requestId || !serviceId || !req.file || !paidAt) {
        return res.status(400).json({ success: false, error: 'Missing fields' })
      }

      const userId = req.userId
      const fileUrl = `/uploads/documents/${req.file.filename}`

      const { data: payment, error: paymentError } = await supabase
        .from('service_fee_payments')
        .insert({
          service_id: serviceId,
          service_finance_id: serviceFinanceId || null,
          payment_type: 'pnbp',
          amount: amount ? Number(amount) : null,
          paid_at: paidAt,
          file_url: fileUrl,
          file_name: req.file.originalname,
          file_mime_type: req.file.mimetype,
          confirmation_status: 'pending',
          notes: notes || null,
          created_by: userId,
        })
        .select()
        .single()

      if (paymentError) throw paymentError

      const { error: updateReqError } = await supabase
        .from('pnbp_requests')
        .update({
          status: 'completed',
          completed_at: new Date().toISOString(),
          completed_by: userId,
        })
        .eq('id', requestId)

      if (updateReqError) throw updateReqError

      res.json({ success: true, data: payment, fileUrl })
    } catch (error) {
      console.error('/api/pnbp/upload-document error', error)
      res.status(500).json({ success: false, error: error.message })
    }
  },
)

// ============================================
// INVOICE ENDPOINTS (REQUEST DARI NOTARIS)
// ============================================
app.post(
  '/api/invoice/request',
  validateRole('notaris', 'ppat', 'syariah', 'admin', 'super_admin'),
  async (req, res) => {
    try {
      const { serviceId, dueDate, amount } = req.body

      if (!serviceId || !dueDate) {
        return res.status(400).json({
          success: false,
          error: 'serviceId dan dueDate wajib diisi',
        })
      }

      const userId = req.userId

      const { data: existing, error: existingError } = await supabase
        .from('service_finances')
        .select('*')
        .eq('service_id', serviceId)
        .eq('follow_up_type', 'Pembuatan Invoice')
        .maybeSingle()

      if (existingError) throw existingError

      if (existing) {
        return res.json({
          success: true,
          message: 'Request invoice untuk layanan ini sudah ada',
          data: existing,
        })
      }

      const { data, error } = await supabase
        .from('service_finances')
        .insert({
          service_id: serviceId,
          follow_up_type: 'Pembuatan Invoice',
          due_date: dueDate,
          amount: amount ?? null,
          status: 'pending',
          created_by: userId,
        })
        .select()
        .single()

      if (error) throw error

      return res.json({
        success: true,
        message: 'Request Invoice berhasil dibuat',
        data,
      })
    } catch (err) {
      console.error('/api/invoice/request error:', err)
      return res.status(500).json({
        success: false,
        error: err.message || 'Internal server error',
      })
    }
  },
)

// ============================================
// NOTIFICATIONS
// ============================================
app.get('/api/notifications/:userId', async (req, res) => {
  try {
    const { unreadOnly, limit = 50 } = req.query
    let query = supabase
      .from('notifications')
      .select('*')
      .eq('user_id', req.params.userId)
      .order('created_at', { ascending: false })
      .limit(parseInt(limit))

    if (unreadOnly === 'true') query = query.eq('is_read', false)

    const { data, error } = await query
    if (error) throw error

    res.json({
      success: true,
      data: data || [],
      unreadCount: data?.filter((n) => !n.is_read).length || 0,
    })
  } catch (error) {
    res.status(500).json({ success: false, error: error.message })
  }
})

app.post('/api/notifications/mark-read', async (req, res) => {
  try {
    if (!req.body.notificationId) {
      return res
        .status(400)
        .json({ success: false, error: 'notificationId required' })
    }

    const { data, error } = await supabase
      .from('notifications')
      .update({ is_read: true })
      .eq('id', req.body.notificationId)
      .select()
      .single()

    if (error) throw error
    res.json({ success: true, data })
  } catch (error) {
    res.status(500).json({ success: false, error: error.message })
  }
})

